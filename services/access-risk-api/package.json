{
  "name": "mg-cr-access-risk-api",
  "version": "1.0.0",
  "description": "Servicio inteligente de riesgo de acceso (MVP)",
  "type": "commonjs",
  "main": "src/index.js",
  "private": true,
  "license": "Enviame",
  "engines": {
    "node": "^24.0.0"
  },
  "jest": {
    "noStackTrace": true,
    "silent": true,
    "verbose": false,
    "collectCoverage": false,
    "coverageDirectory": "tests/.coverage",
    "coverageReporters": ["lcov", "text-summary"],
    "collectCoverageFrom": ["src/**/*.js", "!tests/**"],
    "projects": [
      {
        "displayName": "unit",
        "testMatch": ["<rootDir>/tests/ut/**/*.test.js"]
      },
      {
        "displayName": "integration",
        "testMatch": ["<rootDir>/tests/it/**/*.test.js"]
      }
    ]
  },
  "scripts": {
    "start": "node src/index.js",
    "debug": "node --inspect=0.0.0.0:9229 src/index.js",
    "linter-test": "eslint src/**/*.js tests/**/*.js",
    "linter-fix": "eslint src/**/*.js tests/**/*.js --fix",
    "test_u": "jest --selectProjects unit",
    "test_i": "jest --selectProjects integration",
    "coverage_u": "jest --coverage --selectProjects unit",
    "coverage_i": "jest --coverage --selectProjects integration",
    "coverage_all": "jest --coverage"
  },
  "dependencies": {
    "express": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "pg": "^8.13.1",
    "sequelize": "^6.37.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
}
