#############################################
# Variables utilizadas en docker-compose.yaml
#############################################
DOCKER_LIMITS_CPUS='1'
DOCKER_LIMITS_MEMORY='384M'
DOCKER_STOP_GRACE_PERIOD=500ms
DOCKER_NPM_INSTALL="npm install --prefer-offline --no-audit --progress=false"
DOCKER_COMMAND="${DOCKER_NPM_INSTALL} && npm run start"

########################################
# Variables de ambiente de la APLICACION
########################################
APP_ENV=local
PORT=8080
LOG_LEVEL=info

# Servicio de inferencia (access-risk-model)
# Downstream (modelo) < upstream (mock-auth) para evitar fallback prematuro.
MODEL_SERVICE_URL=http://access-risk-model:8080
MODEL_TIMEOUT_MS=150

# Circuit breaker
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=10000

# Autenticacion servicio a servicio (vacio = deshabilitada en local)
SERVICE_TOKEN=

# Token para los endpoints de gestion del modelo (promote/rollback/retrain/...)
MODEL_MANAGE_TOKEN=
